{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 8,
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "bump",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Go toolchain version pinned in .mise.toml.",
      "managerFilePatterns": [
        "/(^|/)\\.mise\\.toml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)go\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\""
      ],
      "depNameTemplate": "go",
      "packageNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the golangci-lint version the custom-gcl binary is built from.",
      "managerFilePatterns": [
        "/(^|/)\\.custom-gcl\\.yml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)version:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "golangci-lint",
      "packageNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the golint-sl plugin version baked into custom-gcl.",
      "managerFilePatterns": [
        "/(^|/)\\.custom-gcl\\.yml$/"
      ],
      "matchStrings": [
        "module:\\s*\"(?<depName>github\\.com/spechtlabs/golint-sl)\"\\s*\\n\\s*version:\\s*\"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "mise is pinned as MISE_VERSION in every workflow that sets it up; move them at once, and only to a release a day old, the age mise-action waited for before the pin.",
      "matchDepNames": [
        "jdx/mise"
      ],
      "groupName": "mise",
      "groupSlug": "mise",
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Automerge digest, pin, patch, and minor updates once CI passes.",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest",
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Keep major updates explicit.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group GitHub Actions updates together.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Group Go module updates together. The OpenTelemetry modules only build when they move in lockstep, as otel/log v1.47.0 showed.",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go modules",
      "groupSlug": "go-modules"
    },
    {
      "description": "The example ships nothing, so a fix(deps) there would cut a release of the libraries for a dependency nobody gets.",
      "matchFileNames": [
        "example/**"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "otelprovider and otelzap require each other. Every release would bump the other module's requirement, and as a fix(deps) that bump would cut the next release: a loop. The bump rides along with the next real release instead.",
      "matchPackageNames": [
        "github.com/spechtlabs/go-otel-utils/**"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "The Go toolchain is pinned in .mise.toml only; the go.mod files carry no toolchain directive.",
      "matchDatasources": [
        "golang-version"
      ],
      "matchDepNames": [
        "go"
      ],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Leave the go directive in go.mod alone. For a library it is the oldest Go its consumers can build with, not the toolchain; raising it to the newest Go breaks consumers on older ones. Bump it by hand when a dependency needs it. Renovate tracks the toolchain in .mise.toml instead.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "enabled": false
    },
    {
      "description": "golangci-lint is pinned in .mise.toml and .custom-gcl.yml; the two must never disagree.",
      "matchDepNames": [
        "golangci-lint"
      ],
      "groupName": "golangci-lint",
      "groupSlug": "golangci-lint"
    },
    {
      "description": "golint-sl is pinned in .custom-gcl.yml; keep it in a PR of its own, since a new check can need code changes.",
      "matchPackageNames": [
        "/golint-sl$/i"
      ],
      "groupName": "golint-sl",
      "groupSlug": "golint-sl"
    },
    {
      "description": "The commit message check must parse with the release-please version the release-please action bundles (see its package-lock.json), not the newest one. Bump it by hand alongside the action.",
      "matchFileNames": [
        ".github/commit-lint/package.json"
      ],
      "matchPackageNames": [
        "release-please"
      ],
      "enabled": false
    }
  ]
}
